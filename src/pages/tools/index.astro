---
import ToolCard from "@components/ToolCard.astro"; // 你之前写的卡片组件
import MainGridLayout from "@layouts/MainGridLayout.astro";

const tools = [
	{
		title: "神秘工具箱",
		desc: "收集了一些小工具，不定期掉落",
		url: "",
		fullWidth: true,
	},
	{
		title: "卡片测试",
		desc: "点击应该可以正常跳转",
		url: "/tools/test/",
	},
	{
		title: "Shapez2车厢估算",
		desc: "估算所需车厢数量",
		url: "/tools/shapezTrain/",
	},
	{
		title: "今日人品",
		desc: "来看看今日运势ψ(｀∇´)ψ",
		url: "/tools/jrrp/",
	},
	{
		title: "???",
		desc: "线索丢失",
		url: "/tools/lost/",

		isEasterEgg: true,
		key: 0,
	},
	{
		title: "BPM测量",
		desc: "手动敲击 自动计算",
		url: "/tools/bpm/",
	},
	{
		title: "文本筛选",
		desc: "提取或剔除目标字符种类",
		url: "/tools/textFilter/",
	},
	{
		title: "进制转换",
		desc: "将数字转换为目标进制",
		url: "/tools/baseConvertor/",
	},
	/*{
		title: "字数统计",
		desc: "将数字转化为目标进制",
		url: "/tools/wordCounter/",
	},*/
];
---


<MainGridLayout title="工具箱">
  <div slot="top" class="mb-8">
    <h1 class="text-3xl font-bold">571の神秘工具箱</h1>
  </div>

  <!-- 网格 -->
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="tools-grid">
    {tools.map((t, index) => {
      // 大卡
      if (t.fullWidth) {
        return (
          <div class="md:col-span-2 lg:col-span-3 card-base rounded-xl p-6">
            <div class="flex items-center gap-4">
              <div>
                <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">{t.title}</h2>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{t.desc}</p>
              </div>
            </div>
          </div>
        );
      }
      return <ToolCard {...t} />;
    })}
  </div>
</MainGridLayout>
